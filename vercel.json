{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{*.py,*.json,public/*.json,intel/*.py,data/*.json,data/stock/*.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__vpath=/api/$1" },
    { "source": "/healthz", "destination": "/api/index?__vpath=/healthz" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
